{
  "name": "portafolio",
  "version": "0.1.0",
  "private": true,
  "description": "Portafolio personal de Libardo, desarrollador backend (Next.js App Router + Tailwind v4).",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json,md}\"",
    "test": "playwright test",
    "qa": "npm run lint && npm run typecheck && npm run format:check && npm run build && npm run test",
    "cv:pdf": "node --experimental-strip-types scripts/cv-pdf.mts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "16.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
