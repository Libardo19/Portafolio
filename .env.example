# Copiar a .env.local (local) y cargar las mismas variables en Vercel (Settings → Environment Variables).

# URL pública del portafolio. Se usa en canonical, sitemap, robots y JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formulario de contacto (https://resend.com, plan gratis). Sin estas dos, el API responde 503
# y el formulario le dice al visitante que escriba por WhatsApp.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Remitente. Por defecto el de pruebas de Resend (solo entrega al correo de la cuenta de Resend).
# Con dominio propio verificado: "Portafolio <hola@tudominio.com>".
CONTACT_FROM_EMAIL=
